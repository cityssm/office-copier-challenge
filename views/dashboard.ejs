<!doctype html>
<html
  data-theme="light"
  lang="en"
>
  <head>
    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>Office Copier Challenge</title>

    <link href="<%= urlPrefix %>/lib/cityssm-fa-glow/fa-glow.min.css" rel="stylesheet" />
    <link href="<%= urlPrefix %>/lib/bulma/bulma.min.css" rel="stylesheet" />
    <link href="<%= urlPrefix %>/stylesheets/style.css" rel="stylesheet" />
  </head>

  <body>
    <section class="section">
      <div class="container is-fluid">
        <div class="box mb-4">
          <h1 class="is-size-5 has-text-weight-semibold mb-4">Office Copier Challenge</h1>

          <div class="level">
            <div class="level-left">
              <div class="level-item">
                <div class="field">
                  <div class="control has-icons-left">
                    <div class="select is-small">
                      <select id="chartDurationDays" aria-label="Select duration of data to display on chart">
                        <% if (dashboardData.durationOptions.length === 0) { %>
                          <option value="<%= dashboardData.defaultDurationDays %>" selected>No data available</option>
                        <% } else { %>
                          <% for (const durationOption of dashboardData.durationOptions) { %>
                            <option
                              value="<%= durationOption.days %>"
                              <%= durationOption.days === dashboardData.defaultDurationDays ? 'selected' : '' %>
                            >
                              <%= durationOption.label %>
                            </option>
                          <% } %>
                        <% } %>
                      </select>
                    </div>
                    <span class="icon is-small is-left">
                      <i class="fa-solid fa-calendar" aria-hidden="true"></i>
                    </span>
                  </div>
                </div>
              </div>
            </div>
            <div class="level-right">
              <div class="level-item">
                <div class="field">
                  <div class="control has-icons-left">
                    <input
                      id="copierNameFilter"
                      class="input is-small"
                      type="search"
                      placeholder="Copier name"
                      autocomplete="off"
                      aria-label="Filter copiers by name"
                    />
                    <span class="icon is-small is-left">
                      <i class="fa-solid fa-filter" aria-hidden="true"></i>
                    </span>
                  </div>
                </div>
              </div>
              <div class="level-item">
                <button
                  id="toggleHiddenCopiers"
                  class="button is-small is-light"
                  type="button"
                  aria-pressed="false"
                >
                  Show hidden copiers
                </button>
              </div>
            </div>
          </div>

          <% const copierCount = dashboardData.copiers.length %>
          <% const baseBandSize = Math.floor(copierCount / 3) %>
          <% const remainderCount = copierCount % 3 %>
          <% const topBandSize = baseBandSize + (remainderCount >= 1 ? 1 : 0) %>
          <% const middleBandSize = baseBandSize + (remainderCount >= 2 ? 1 : 0) %>
          <% const topBandEndIndex = topBandSize %>
          <% const middleBandEndIndex = topBandSize + middleBandSize %>

          <div id="copierSelection" class="columns is-multiline">
            <% for (let copierIndex = 0; copierIndex < dashboardData.copiers.length; copierIndex += 1) { %>
              <% const copier = dashboardData.copiers[copierIndex] %>
              <% const copierBandClass =
                copierIndex < topBandEndIndex
                  ? 'has-background-danger-light'
                  : copierIndex < middleBandEndIndex
                    ? 'has-background-warning-light'
                    : 'has-background-success-light' %>
              <% const copierTierLabel =
                copierIndex < topBandEndIndex
                  ? 'High usage'
                  : copierIndex < middleBandEndIndex
                    ? 'Medium usage'
                    : 'Low usage' %>
              <% const mediumTierTransform = 'up-2 left-2 shrink-1' %>
              <% const highTierTransforms = [mediumTierTransform, 'up-4 left-4 shrink-2'] %>
              <% const copierTierIconConfig = (() => {
                if (copierIndex < topBandEndIndex) {
                  return {
                    iconClass: 'has-text-danger',
                    transforms: highTierTransforms
                  }
                }

                if (copierIndex < middleBandEndIndex) {
                  return {
                    iconClass: 'has-text-warning',
                    transforms: [mediumTierTransform]
                  }
                }

                return {
                  iconClass: 'has-text-success',
                  transforms: []
                }
              })() %>
              <div
                class="column is-half-tablet is-one-third-desktop js-copier-option"
                data-copier-name="<%= copier.copierName.toLowerCase() %>"
              >
                <label class="checkbox is-block p-2 <%= copierBandClass %>">
                  <input
                    type="checkbox"
                    class="js-copier-checkbox"
                    value="<%= copier.copierId %>"
                  />
                  <span class="icon ml-2 mr-2" title="<%= copierTierLabel %>">
                    <span class="fa-layers fa-fw <%= copierTierIconConfig.iconClass %>">
                      <i class="fa-solid fa-file" data-fa-glow="10" aria-hidden="true"></i>
                      <% for (const iconTransform of copierTierIconConfig.transforms) { %>
                        <i
                          class="fa-solid fa-file"
                          data-fa-transform="<%= iconTransform %>"
                          data-fa-glow="10"
                          aria-hidden="true"
                        ></i>
                      <% } %>
                    </span>
                  </span>
                  <span class="is-sr-only"><%= copierTierLabel %></span>
                  <span>
                    <span class="js-copier-name"><%= copier.copierName %></span>
                    <span
                      class="icon is-small ml-1 js-copier-range-warning is-hidden"
                      hidden
                    >
                      <i class="fa-regular fa-clock" aria-hidden="true"></i>
                      <span class="is-sr-only">Limited data range</span>
                    </span>
                    <small>
                      (<span class="js-copier-count"><%= copier.totalPrints.toLocaleString() %></span>
                      prints)
                    </small>
                  </span>
                </label>
              </div>
            <% } %>
          </div>

          <div class="buttons are-small mt-2">
            <button id="selectAllCopiers" class="button is-light" type="button">Select all</button>
            <button id="deselectAllCopiers" class="button is-light" type="button">Deselect all</button>
            <button id="resetCopierSelection" class="button is-link is-light" type="button">
              Select Top 10
            </button>
          </div>
        </div>

        <div class="box mb-4">
          <div id="copierUsageChart" style="height: 420px"></div>
          <p class="has-text-right">
            <button id="exportCsv" class="button is-light is-small" type="button">Export Data as CSV</button>
          </p>
        </div>

        <div class="mb-4" id="kpiSection">
          <div class="columns has-text-centered">
            <div class="column is-6-desktop">
              <article class="kpi-card kpi-card-info">
                <p class="kpi-name">Total prints (all copiers)</p>
                <p id="kpiTotalPrintsValue" class="kpi-value">Loading&hellip;</p>
                <p id="kpiTotalPrintsContext" class="kpi-context"></p>
              </article>
            </div>
            <div class="column is-6-desktop">
              <article class="kpi-card kpi-card-info">
                <div>
                  <p class="kpi-name">What that means</p>
                  
                  <div class="columns">
                    <div class="column">
                      <span id="kpiEstimatedPagesValue" class="kpi-value">Loading&hellip;</span><br />
                      pages <sup>1</sup>
                    </div>  
                    <div class="column">
                      <span id="kpiEstimatedReamsValue" class="kpi-value">Loading&hellip;</span><br />
                      reams
                    </div>
                  </div>
                  <div class="columns">
                    <div class="column">
                      <span id="kpiEstimatedCartonsValue" class="kpi-value">Loading&hellip;</span><br />
                      boxes
                    </div>
                    <div class="column">
                      <span id="kpiEstimatedTreesValue" class="kpi-value">Loading&hellip;</span><br />
                      trees <sup>2</sup>
                    </div>
                  </div>
                </div>
                <p class="is-size-7 mt-2">
                  <sup>1</sup> Assuming half of all prints are double-sided.<br />
                  <sup>2</sup> Tree estimate provided by <a
                    href="http://conservatree.org/learn/EnviroIssues/TreeStats.shtml"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Conservatree</a>.
                </p>
              </article>
            </div>
          </div>
          <div class="columns has-text-centered">
            <div class="column is-one-third-desktop">
              <article class="kpi-card kpi-card-danger mb-5">
                <p class="kpi-name">Busiest hour (all copiers)</p>
                <p id="kpiBusiestHourValue" class="kpi-value">Loading&hellip;</p>
                <p id="kpiBusiestHourContext" class="kpi-context"></p>
              </article>
              <article class="kpi-card kpi-card-danger">
                <p class="kpi-name">Busiest copier &amp; hour</p>
                <p id="kpiBusiestCopierHourValue" class="kpi-value">Loading&hellip;</p>
                <p id="kpiBusiestCopierHourContext" class="kpi-context"></p>
              </article>
            </div>
            <div class="column is-one-third-desktop">
              <article class="kpi-card kpi-card-warning mb-5">
                <p class="kpi-name">Most consecutive hours with most prints</p>
                <p id="kpiTopCopierStreakValue" class="kpi-value">Loading&hellip;</p>
                <p id="kpiTopCopierStreakContext" class="kpi-context"></p>
              </article>
              <article class="kpi-card kpi-card-warning">
                <p class="kpi-name">Most consecutive hours printing</p>
                <p id="kpiActiveStreakValue" class="kpi-value">Loading&hellip;</p>
                <p id="kpiActiveStreakContext" class="kpi-context"></p>
              </article>
            </div>
            <div class="column is-one-third-desktop">
              <article class="kpi-card kpi-card-success mb-5">
                <p class="kpi-name">Most consecutive hours with fewer than 5 prints</p>
                <p id="kpiLowPrintStreakValue" class="kpi-value">Loading&hellip;</p>
                <p id="kpiLowPrintStreakContext" class="kpi-context"></p>
              </article>
              <article class="kpi-card kpi-card-success">
                <p class="kpi-name">Most hours overall with fewer than 5 prints per hour</p>
                <p id="kpiLowPrintHoursValue" class="kpi-value">Loading&hellip;</p>
                <p id="kpiLowPrintHoursContext" class="kpi-context"></p>
              </article>
            </div>
          </div>
        </div>

        <div class="box has-text-centered mb-4">
          <a href="#" id="aboutLink">About this Challenge</a>
          <span class="mx-2">&middot;</span>
          <a href="#" id="tipsLink">Tips to Reduce your Prints</a>
        </div>
      </div>
    </section>

    <div id="aboutModal" class="modal">
      <div class="modal-background js-about-modal-close"></div>
      <div class="modal-card" style="width: 900px">
        <header class="modal-card-head">
          <p class="modal-card-title">Office Copier Challenge</p>
          <button class="delete js-about-modal-close" aria-label="close" type="button"></button>
        </header>
        <section class="modal-card-body">
          <p class="mb-3 has-text-centered">
            <video src="<%= urlPrefix %>/images/video.mp4" controls muted autoplay loop playsinline aria-label="Green Team promotional video"></video>
          </p>
          <p class="mb-3">
            <strong class="has-text-success-dark">The Green Team</strong> has challenged all departments to increase the sustainability efforts in their workplaces.
            IT is up for the challenge and has created this dashboard to help everyone understand
            their department's printing habits and identify opportunities to reduce paper use.
          </p>
          <p class="title is-4 mb-3">How it Works</p>
          <p class="mb-3">
            This dashboard collects total print counts from the office copiers every twenty minutes.
            <em>Desktop printers are not included in the totals.</em>
            The difference between data points from the current and previous hour are used to estimate
            the number of prints for each copier for each hour.
          </p>
          <p class="mb-3">
            More questions? See the
            <a
              href="https://cityssm.github.io/office-copier-challenge/#frequently-asked-questions-faqs"
              target="_blank"
              rel="noopener noreferrer"
            >FAQs</a>.
          </p>
          <p class="title is-4 mb-3">How Can I Use This Dashboard?</p>
          <ul class="fa-ul">
            <li class="mb-2">
              <span class="fa-li has-text-success">
                <i class="fa-solid fa-lightbulb"></i>
              </span>
              <strong class="has-text-success-dark">Compare printing trends</strong> and identify opportunities to print less.
            </li>
            <li class="mb-2">
              <span class="fa-li has-text-success">
                <i class="fa-solid fa-lightbulb"></i>
              </span>
              <strong class="has-text-success-dark">Challenge another department</strong> with similar printing levels
              to reduce their printing with you and compete to be the most sustainable department!
            </li>
            <li class="mt-2">
              <span class="fa-li has-text-success">
                <i class="fa-solid fa-lightbulb"></i>
              </span>
              <strong class="has-text-success-dark">Aim for a "green team" copier</strong> by reducing your prints and moving down to the low usage tier!
            </li>
          </ul>
        </section>
        <footer class="modal-card-foot is-justify-content-end">
          <button class="button js-about-modal-close" type="button">Close</button>
        </footer>
      </div>
    </div>

    <div id="tipsModal" class="modal">
      <div class="modal-background js-tips-modal-close"></div>
      <div class="modal-card" style="width: 900px">
        <header class="modal-card-head">
          <p class="modal-card-title">Tips to Reduce your Prints</p>
          <button class="delete js-tips-modal-close" aria-label="close" type="button"></button>
        </header>
        <section class="modal-card-body">
          <div class="message is-success">
            <div class="message-body">
              <p class="has-text-weight-bold">
                Every print job reduced helps!
              </p>
              <p>
                Even small changes in printing habits can add up to significant paper and energy savings over time.
              </p>
              <p>
                Ask the IT Helpdesk if you need help putting any of these tips into practice!
              </p>  
            </div>
          </div>

          <p class="title is-4 mb-3">Check Your Work Before Printing</p>
          <ul class="fa-ul">
            <li class="mb-2">
              <span class="fa-li has-text-success">
                <i class="fa-solid fa-leaf"></i>
              </span>
              <strong class="has-text-success-dark">Proofread documents on-screen</strong> to avoid reprints for typos or formatting issues.
            </li>
            <li class="mb-2">
              <span class="fa-li has-text-success">
                <i class="fa-solid fa-leaf"></i>
              </span>
              <strong class="has-text-success-dark">Use print preview</strong> to check formatting and catch errors before printing.
            </li>
          </ul>

          <p class="title is-4 mb-3">Fill Each Page</p>
          <ul class="fa-ul">
            <li class="mb-2">
              <span class="fa-li has-text-success">
                <i class="fa-solid fa-leaf"></i>
              </span>
              <strong class="has-text-success-dark">Use smaller font sizes and reduced margins</strong> to fit more content per page.
            </li>
            <li class="mb-2">
              <span class="fa-li has-text-success">
                <i class="fa-solid fa-leaf"></i>
              </span>
              <strong class="has-text-success-dark">Print multiple pages per sheet</strong>
              (e.g. 2 or 4) for drafts or reference materials.
            </li>
            <li class="mb-2">
              <span class="fa-li has-text-success">
                <i class="fa-solid fa-leaf"></i>
              </span>
              <strong class="has-text-success-dark">Print double-sided (duplex)</strong>
              to cut paper use in half.
            </li>
            <li class="mb-2">
              <span class="fa-li has-text-success">
                <i class="fa-solid fa-leaf"></i>
              </span>
              <strong class="has-text-success-dark">Print only the pages you need</strong> using "Print Selection" or specifying page ranges.
            </li>
            <li class="mb-2">
              <span class="fa-li has-text-success">
                <i class="fa-solid fa-leaf"></i>
              </span>
              <strong class="has-text-success-dark">Use draft or economy print quality</strong> for internal documents.
            </li>
          </ul>

          <p class="title is-4 mb-3">Skip Printing Altogether</p>
          <ul class="fa-ul">
            <li class="mb-2">
              <span class="fa-li has-text-success">
                <i class="fa-solid fa-leaf"></i>
              </span>
              <strong class="has-text-success-dark">Share documents digitally</strong> via email or shared drives instead of printing copies.
            </li>
            <li class="mb-2">
              <span class="fa-li has-text-success">
                <i class="fa-solid fa-leaf"></i>
              </span>
              <strong class="has-text-success-dark">Cancel unnecessary print jobs</strong> before they complete.
            </li>
            <li class="mb-2">
              <span class="fa-li has-text-success">
                <i class="fa-solid fa-leaf"></i>
              </span>
              <strong class="has-text-success-dark">Use electronic tools</strong>
              like fillable forms, electronic signatures, and electronic redaction instead of printing
              and handling physical documents.
            </li>
          </ul>
        </section>
        <footer class="modal-card-foot is-justify-content-end">
          <button class="button js-tips-modal-close" type="button">Close</button>
        </footer>
      </div>
    </div>

    <div id="refreshToast" class="notification is-info" hidden>
      <p class="mb-2"><strong>New data may be available.</strong></p>
      <p class="mb-3">This page was loaded over 20 minutes ago.</p>
      <div class="buttons are-small">
        <button id="refreshToastRefresh" class="button is-info is-inverted" type="button">Refresh now</button>
        <button id="refreshToastDismiss" class="button is-light" type="button">Dismiss</button>
      </div>
    </div>

    <script id="dashboardData" type="application/json"><%- dashboardDataJson %></script>

    <script src="<%= urlPrefix %>/lib/echarts/echarts.js"></script>
    <script src="<%= urlPrefix %>/javascripts/dashboard.js"></script>
    <script src="<%= urlPrefix %>/lib/fa/js/all.min.js" defer></script>
  </body>
</html>
