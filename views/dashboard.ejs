<!doctype html>
<html
  data-theme="light"
  lang="en"
>
  <head>
    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>Office Copier Challenge</title>

    <link href="<%= urlPrefix %>/lib/bulma/bulma.min.css" rel="stylesheet" />
    <link href="<%= urlPrefix %>/stylesheets/style.css" rel="stylesheet" />
    <link href="<%= urlPrefix %>/lib/fa/css/all.min.css" rel="stylesheet" />
  </head>

  <body>
    <section class="section">
      <div class="container is-fluid">
        <div class="box mb-4">
          <h1 class="is-size-5 has-text-weight-semibold mb-2">Office Copier Challenge</h1>

          <div class="level">
            <div class="level-left">
              <div class="field mb-4">
                <label class="label is-small" for="chartDurationDays">Data to display</label>
                <div class="control">
                  <div class="select is-small">
                    <select id="chartDurationDays">
                      <% if (dashboardData.durationOptions.length === 0) { %>
                        <option value="<%= dashboardData.defaultDurationDays %>" selected>No data available</option>
                      <% } else { %>
                        <% for (const durationOption of dashboardData.durationOptions) { %>
                          <option
                            value="<%= durationOption.days %>"
                            <%= durationOption.days === dashboardData.defaultDurationDays ? 'selected' : '' %>
                          >
                            <%= durationOption.label %>
                          </option>
                        <% } %>
                      <% } %>
                    </select>
                  </div>
                </div>
              </div>
            </div>
            <div class="level-right">
              <button
                id="toggleHiddenCopiers"
                class="button is-small is-light mt-4"
                type="button"
                aria-pressed="false"
              >
                Show hidden copiers
              </button>
            </div>
          </div>

          <% const copierCount = dashboardData.copiers.length %>
          <% const baseBandSize = Math.floor(copierCount / 3) %>
          <% const remainderCount = copierCount % 3 %>
          <% const topBandSize = baseBandSize + (remainderCount >= 1 ? 1 : 0) %>
          <% const middleBandSize = baseBandSize + (remainderCount >= 2 ? 1 : 0) %>
          <% const topBandEndIndex = topBandSize %>
          <% const middleBandEndIndex = topBandSize + middleBandSize %>

          <div id="copierSelection" class="columns is-multiline">
            <% for (let copierIndex = 0; copierIndex < dashboardData.copiers.length; copierIndex += 1) { %>
              <% const copier = dashboardData.copiers[copierIndex] %>
              <% const copierBandClass =
                copierIndex < topBandEndIndex
                  ? 'has-background-danger-light'
                  : copierIndex < middleBandEndIndex
                    ? 'has-background-warning-light'
                    : 'has-background-success-light' %>
              <% const copierTierLabel =
                copierIndex < topBandEndIndex
                  ? 'High usage'
                  : copierIndex < middleBandEndIndex
                    ? 'Medium usage'
                    : 'Low usage' %>
              <% const copierTierIconClass =
                copierIndex < topBandEndIndex
                  ? 'fa-solid fa-file has-text-danger'
                  : copierIndex < middleBandEndIndex
                    ? 'fa-solid fa-file has-text-warning'
                    : 'fa-solid fa-file has-text-success' %>
              <div class="column is-half-tablet is-one-third-desktop js-copier-option">
                <label class="checkbox is-block p-2 <%= copierBandClass %>">
                  <input
                    type="checkbox"
                    class="js-copier-checkbox"
                    value="<%= copier.copierId %>"
                  />
                  <span class="icon ml-2 mr-2" title="<%= copierTierLabel %>">
                    <i class="<%= copierTierIconClass %>" aria-hidden="true"></i>
                  </span>
                  <span class="is-sr-only"><%= copierTierLabel %></span>
                  <span><%= copier.copierName %> (<%= copier.totalPrints.toLocaleString() %> prints)</span>
                </label>
              </div>
            <% } %>
          </div>

          
        </div>

        <div class="box mb-4">
          <div id="copierUsageChart" style="height: 420px"></div>
        </div>

        <div class="box has-text-centered mb-4">
          <a href="#" id="aboutLink">About this Challenge</a>
          <span class="mx-2">&middot;</span>
          <a href="#" id="tipsLink">Tips to Reduce your Prints</a>
        </div>

      </div>
    </section>

    <div id="aboutModal" class="modal">
      <div class="modal-background js-about-modal-close"></div>
      <div class="modal-card">
        <header class="modal-card-head">
          <p class="modal-card-title">Office Copier Challenge</p>
          <button class="delete js-about-modal-close" aria-label="close" type="button"></button>
        </header>
        <section class="modal-card-body">
          <p class="mb-3 has-text-centered">
            <img src="<%= urlPrefix %>/images/greenTeam.jpg" alt="Green Team Logo" />
          </p>
          <p class="mb-3">
            <strong class="has-text-success-dark">The Green Team</strong> has challenged all departments to increase their sustainability efforts in their workplaces.
            IT is up for the challenge and has created this dashboard to help everyone understand
            their department's printing habits and identify opportunities to reduce paper use.
          </p>
          <p>
            Use the dashboard to compare printing trends and identify opportunities to print less.
          </p>
        </section>
        <footer class="modal-card-foot is-justify-content-end">
          <button class="button js-about-modal-close" type="button">Close</button>
        </footer>
      </div>
    </div>

    <div id="tipsModal" class="modal">
      <div class="modal-background js-tips-modal-close"></div>
      <div class="modal-card">
        <header class="modal-card-head">
          <p class="modal-card-title">Tips to Reduce your Prints</p>
          <button class="delete js-tips-modal-close" aria-label="close" type="button"></button>
        </header>
        <section class="modal-card-body">
          <ul class="fa-ul">
            <li class="mb-2">
              <span class="fa-li">
                <i class="fa-solid fa-leaf"></i>
              </span>
              Print double-sided (duplex) to cut paper use in half.
            </li>
            <li class="mb-2">
              <span class="fa-li">
                <i class="fa-solid fa-leaf"></i>
              </span>
              Preview documents before printing to avoid reprints.
            </li>
            <li class="mb-2">
              <span class="fa-li">
                <i class="fa-solid fa-leaf"></i>
              </span>
              Use "Print Selection" or "Print to PDF" instead of printing the full document.
            </li>
            <li class="mb-2">
              <span class="fa-li">
                <i class="fa-solid fa-leaf"></i>
              </span>
              Share documents digitally via email or shared drives instead of printing copies.
            </li>
            <li class="mb-2">
              <span class="fa-li">
                <i class="fa-solid fa-leaf"></i>
              </span>
              Use smaller font sizes and reduced margins to fit more content per page.
            </li>
            <li class="mb-2">
              <span class="fa-li">
                <i class="fa-solid fa-leaf"></i>
              </span>
              Cancel unnecessary print jobs before they complete.
            </li>
            <li class="mb-2">
              <span class="fa-li">
                <i class="fa-solid fa-leaf"></i>
              </span>
              Proofread on-screen before printing to reduce error reprints.
            </li>
            <li>
              <span class="fa-li">
                <i class="fa-solid fa-leaf"></i>
              </span>
              Use draft or economy print quality for internal documents.
            </li>
            <li>
              <span class="fa-li">
                <i class="fa-solid fa-leaf"></i>
              </span>
              Use tools like electronic signatures and electronic redaction instead of printing
              for signing or confidential information.
            </li>
          </ul>
        </section>
        <footer class="modal-card-foot is-justify-content-end">
          <button class="button js-tips-modal-close" type="button">Close</button>
        </footer>
      </div>
    </div>

    <script id="dashboardData" type="application/json"><%- dashboardDataJson %></script>

    <script src="<%= urlPrefix %>/lib/echarts/echarts.js"></script>
    <script src="<%= urlPrefix %>/javascripts/dashboard.js"></script>
    <script src="<%= urlPrefix %>/lib/fa/js/all.min.js" defer></script>
  </body>
</html>
